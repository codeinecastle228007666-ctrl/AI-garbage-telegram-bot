# Google Gemini API (бесплатно, https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# DeepSeek API (работает из РФ, https://platform.deepseek.com)
# DEEPSEEK_API_KEY=

# Groq API (бесплатно, Llama 3 70B, https://console.groq.com)
# GROQ_API_KEY=

# AI_PROVIDER=auto (приоритет: Groq > DeepSeek > Gemini)
# AI_PROVIDER=groq
# AI_PROVIDER=deepseek
# AI_PROVIDER=gemini

# Прокси (если Telegram заблокирован)
# BOT_PROXY=socks5://127.0.0.1:1080

SCHEDULER_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
